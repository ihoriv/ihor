            <div class="icon-text_icon">
              <img src="/images/kharkiv-logo.webp" loading="lazy" width="36" height="32" alt="" />
            </div>
            <p class="icon-text-label">Kharkiv, Ukraine</p>
          </div>
        </div>
        <div class="line-divider_wrap">
          <div class="line-divider"></div>
        </div>
        <div class="about_icon--texts">
          <div class="about_icon-wrap" data-flip-in>
            <img src="/images/about-icon.svg" loading="lazy" width="80" height="80" alt="" />
          </div>
          <p data-text-appear="line">
            My name is Ihor and I create websites. I am not just a designer or a developer; I am a business analyst, an art director, and a certified Premium Webflow Partner.
          </p>
          <p data-text-appear="line">
            The sites I create is a storytelling. It's the experience you want your brand to represent online. If you are a great founder who changes the world, you need a tool that will help you with it. I am here to give you this tool.
          </p>
        </div>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>

  <section id="services" class="services-section section-black">
    <div class="u---spacer"></div>
    <div class="section-heading" data-reveal>
      <h2 data-text-appear="line">Different <em>services,</em> same result</h2>
    </div>
    <div class="swiper is--services">
      <div class="swiper-wrapper is--services">
        {
          services.map((service) => (
            <div class="swiper-slide is--services">
              <div class="services-slide_content-wrap">
                <div class="service_texts-wrap">
                  <div class="service-heading">
                    <div class="service_number-wrap">
                      <p>{service.number}</p>
                    </div>
                    <h3>{service.name}</h3>
                  </div>
                  <div class="service_description">
                    <p>{service.description}</p>
                  </div>
                </div>
                <div class="service-slide_image">
                  <img
                    width="1440"
                    height="900"
                    alt=""
                    src={`/images/${service.image}.avif`}
                    loading="lazy"
                    sizes="(max-width: 991px) 100vw, 1440px"
                    srcset={`/images/${service.image}-p-500.avif 500w, /images/${service.image}-p-800.avif 800w, /images/${service.image}-p-1080.avif 1080w, /images/${service.image}-p-1600.avif 1600w, /images/${service.image}-p-2000.avif 2000w, /images/${service.image}-p-2600.avif 2600w, /images/${service.image}.avif 2880w`}
                  />
                  <div class="service-slide_image-gradient"></div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="services_pagination-wrap">
      <div class="services_pagination"></div>
    </div>
  </section>

  <section id="approach" class="section-approach">
    <div class="u---spacer is--full"></div>
    <div class="container">
      <div class="section-content">
        <div class="section-heading" data-reveal>
          <h2 data-text-appear="line">A <em>website</em> is six different jobs. I do all six properly.</h2>
        </div>
        <div class="approach_content-wrap">
          <div class="approach_cards-wrap">
            {
              approachCards.map((card, i) => (
                <div class="approach-card" data-reveal tabindex="0">
                  <div class="approach-card_number--heading">
                    <p class="approach-card_number">{card.number}</p>
                    <h2 class="h-big-heading">{card.title}</h2>
                  </div>
                  <div class="approach-card_texts-wrap">
                    <div class="approach-card_texts-inner">
                      <p>{card.small}</p>
                      <p>{card.big}</p>
                    </div>
                  </div>
                  <div class="approach-card_hidden">
                    <div class="approach-card_image-wrap">
                      <img
                        width="848"
                        height="1040"
                        alt=""
                        src={`/images/${card.image}.webp`}
                        loading={i === 0 ? 'eager' : 'lazy'}
                      />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="approach_image-placeholder"></div>
        </div>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>

  <section id="reviews">
    <div class="u---spacer"></div>
    <div class="container">
      <div class="section-content">
        <div class="section-heading" data-reveal>
          <h2 data-text-appear="line">The <em>clients</em> say it better than I can.</h2>
        </div>
        <div class="clients-grid">
          {
            testimonials.map((t) => (
              <div class="client-card" data-client-video={t.video} data-reveal>
                <div class="client-card_info-wrap">
                  <div class="client-card_logo--button">
                    <div class="client-card_logo">
                      <img loading="lazy" src={t.logo} alt={`${t.company} logo`} />
                    </div>
                    <button type="button" class="button client-card_play-button" data-video-open={t.video} aria-label="Play Video">
                      <span class="text-link">
                        <span class="text-link__label">Play Video</span>
                      </span>
                      <span class="button_icon-wrap">
                        <span class="button-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M6 0L7.62054 4.37946L12 6L7.62054 7.62054L6 12L4.37946 7.62054L0 6L4.37946 4.37946L6 0Z" fill="currentColor"></path>
                          </svg>
                        </span>
                      </span>
                    </button>
                  </div>
                  <div class="clients-card_texts-wrap">
                    <p class="clients-card_quote">{t.quote}</p>
                    <div class="clients-card_person-info">
                      <p class="clients-card_person-name">{t.name}</p>
                      <p class="clients-card_person-description">{t.title}</p>
                    </div>
                  </div>
                </div>
                <div class="clients-card_gradient-wrap"></div>
                <div class="clients-card_video-wrap"></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>

  <section id="faq">
    <div class="u---spacer"></div>
    <div class="container">
      <div class="section-content">
        <div class="section-heading" data-reveal>
          <h2 data-text-appear="line">The <em>questions</em> clients usually ask before signing</h2>
        </div>
        <div class="faq_content-wrap">
          {
            faqs.map((faq, i) => (
              <div class="faq_card-wrap" data-reveal>
                <div class="faq-card_title-wrap">
                  <p class="faq-card_number">{`(${String(i + 1).padStart(2, '0')})`}</p>
                  <h3 class="h-big-heading">{faq.q}</h3>
                </div>
                <div class="faq-card_description-wrap">
                  <p>{faq.a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>

  <section>
    <div class="u---spacer"></div>
    <div class="container">
      <div class="section-content">
        <div class="section-heading" data-reveal>
          <h2 data-text-appear="line">Feel the <em>vibe</em> of the work</h2>
        </div>
        <div class="playlist-wrap">
          <iframe
            allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
            frameborder="0"
            height="100%"
            style="width:100%;max-width:100%;overflow:hidden;"
            sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
            src="https://embed.music.apple.com/us/playlist/working/pl.u-PDb4zE5teDZzKGM"></iframe>
        </div>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>

  <VideoPopup />
</Layout>

