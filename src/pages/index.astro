const projectDescriptionBig = 'Corporate Website for the Construction Company. Designed and built from scratch.';
const projectDescriptionSmall =
  'Full re-design and migration to Webflow from another platform. I’ve created the design system, created the UI and built it on Webflow using “The Webflow Way” approach.';

const services = [
  {
    name: 'Website Build',
    number: '(01)',
    description:
      "A complete site from scratch — strategy, structure, design, and Webflow development handled end to end. For businesses launching, repositioning, or replacing a site that's no longer doing its job.",
    image: 'Service-Image',
  },
  {
    name: 'Webflow Development',
    number: '(02)',
    description:
      'Pixel-accurate Webflow builds from your existing design. Clean structure, scalable CMS, easy handover. For designers, agencies, and in-house teams who need development done properly.',
    image: 'Service-Image-1',
  },
  {
    name: 'Migration to Webflow',
    number: '(03)',
    description:
      'Move your site off WordPress, Wix, or any legacy platform — without losing content, rankings, or the things that already work. Faster performance, lower maintenance, full control afterwards.',
    image: 'Service-Image-2',
  },
  {
    name: 'SEO / GEO',
    number: '(04)',
    description:
      'Technical and on-page optimization for sites that should rank higher in search — and appear more often in AI-generated answers. Built into new projects by default, or done as an engagement on existing sites.',
    image: 'Service-Image-3',
  },
  {
    name: 'Website Audit',
    number: '(05)',
    description:
      "A full teardown of your existing site's structure, performance, and conversion path, with a prioritized list of what to fix first and why.",
    image: 'Service-Image-4',
  },
];

const approachCards = [
  {
    number: '(01)',
    title: 'Business positioning before design',
    small:
      'I start by understanding how the business actually makes money, what its sales cycle looks like, and how customers decide. The site is built backwards from that — not from a moodboard.',
    big: "Sites built without this look good and convert poorly. The structure reflects the designer's taste instead of the customer's decision path.",
    image: 'Service-Picture-01',
  },
  {
    number: '(02)',
    title: 'Information architecture and content logic',
    small:
      'Every page has a job, every section has a reason to exist, and every block moves the reader toward a specific next action. Structure is decided before a single component is designed.',
    big: 'When this is skipped, you get beautiful pages that bury the things customers actually came for. Visitors leave, and nobody can explain why.',
    image: 'Service-Picture-02',
  },
  {
    number: '(03)',
    title: 'Design that supports the message, not replaces it',
    small:
      'Visual decisions follow the structure, not the other way around. Typography, hierarchy, spacing, and motion exist to make the content easier to absorb — not to demonstrate that the designer has Behance.',
    big: 'Design-first sites win awards and lose deals. Visitors remember the animations and forget what the company does.',
    image: 'Service-Picture-03',
  },
  {
    number: '(04)',
    title: 'Clean, scalable Webflow build',
    small:
      "Properly structured CMS, semantic class system, reusable components, accessible interactions, and a project a non-technical client can actually edit afterwards without breaking.",
    big: 'Most Webflow projects look fine on launch and become unmaintainable within six months. Class names like "Div Block 47" are not a build — they\'re a future invoice.',
    image: 'Service-Picture-04',
  },
  {
    number: '(05)',
    title: 'Accessibility and legal compliance',
    small:
      'WCAG-aware structure, proper contrast, keyboard navigation, semantic HTML, font and image licensing handled correctly. Not as a checklist — as the default state.',
    big: 'EU regulation now treats accessibility as a legal requirement, not a nice-to-have. Sites that ignore this are one complaint away from a takedown notice or a fine.',
    image: 'Service-Picture-05',
  },
  {
    number: '(06)',
    title: 'Performance and search visibility',
    small:
      'Optimized assets, clean code, proper metadata, semantic structure, and Core Web Vitals that pass. Not bolted on after launch — built in from the first component.',
    big: "A site that loads in five seconds loses half its visitors before they see the headline. A site that doesn't get indexed properly costs you traffic you'll never know you missed.",
    image: 'Service-Picture-06',
  },
];

