---
import BaseLayout from '../layouts/BaseLayout.astro';
import Legal from '../components/sections/Legal.astro';
import { privacy } from '../data/legal';
import { site } from '../data/site';
---
<BaseLayout title={`${privacy.name} — ${site.name}`} description={privacy.description} breadcrumb={privacy.name} modified={privacy.updatedIso}>
  <Legal doc={privacy} />
</BaseLayout>
