---
import BaseLayout from '../layouts/BaseLayout.astro';
import Legal from '../components/sections/Legal.astro';
import { terms } from '../data/legal';
import { site } from '../data/site';
---
<BaseLayout title={`${terms.name} — ${site.name}`} description={terms.description} breadcrumb={terms.name} modified={terms.updatedIso}>
  <Legal doc={terms} />
</BaseLayout>
