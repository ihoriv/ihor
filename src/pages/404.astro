---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — ihor.me" description="The page you're looking for doesn't exist." noindex>
  <section class="legal-section">
    <div class="u---spacer is--full"></div>
    <div class="container">
      <div class="legal-content" data-reveal>
        <h1>404 — Page not found</h1>
        <p>The page you're looking for doesn't exist or has moved.</p>
        <p><a href="/">Back to the homepage</a></p>
      </div>
    </div>
    <div class="u---spacer"></div>
  </section>
</Layout>

<script is:inline src="/scripts/site.js"></script>
