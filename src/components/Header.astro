---
// Site header / nav. The hamburger opens `.menu-wrap`, a full-screen overlay
// already in the DOM (see #site-menu-script in Layout.astro for the toggle).
const navItems = [
  { label: 'Portfolio', href: '#projects' },
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'Approach', href: '#approach' },
];
const doubleItems = [
  { label: 'Client Reviews', href: '#reviews' },
  { label: 'FAQ', href: '#faq' },
];
---

<header class="header">
  <div class="container">
    <div class="header_content-wrap">
      <button type="button" class="menu-button" aria-expanded="false" aria-controls="site-menu">
        <span class="text-link is--menu">
          <span class="text-link__label">Menu</span>
        </span>
        <span class="menu-button_lines">
          <span class="menu-line is--top"></span>
          <span class="menu-line is--bottom"></span>
        </span>
      </button>
      <a aria-label="Go to Homepage" href="/" class="header-logo">
