      </a>
      <a class="button" href="https://cal.com/ihor.me/project-discussion" target="_blank" rel="noopener">
        <span class="text-link">
          <span class="text-link__label">Start a project</span>
        </span>
        <span class="button_icon-wrap">
          <span class="button-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M6 0L7.62054 4.37946L12 6L7.62054 7.62054L6 12L4.37946 7.62054L0 6L4.37946 4.37946L6 0Z" fill="currentColor"></path>
            </svg>
          </span>
        </span>
      </a>
    </div>
  </div>

  <nav id="site-menu" class="menu-wrap" aria-label="Site navigation">
    {
      navItems.map((item) => (
        <a href={item.href} class="menu-card">
          <span class="text-link is--menu">
            <span class="text-link__label">{item.label}</span>
            <span class="text-link__label text-link__label--dup" aria-hidden="true">{item.label}</span>
          </span>
        </a>
      ))
    }
    <div class="menu-card_double">
      {
        doubleItems.map((item) => (
          <a href={item.href} class="menu-card">
            <span class="text-link is--menu">
              <span class="text-link__label">{item.label}</span>
              <span class="text-link__label text-link__label--dup" aria-hidden="true">{item.label}</span>
            </span>
          </a>
        ))
      }
    </div>
  </nav>
</header>
