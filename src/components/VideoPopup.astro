---
// Shared modal video player. Opened by the standalone video block, the
// approach cards, and the client testimonial cards — see site.js.
---

<div class="video-popup" aria-hidden="true">
  <div class="video-popup_overlay" data-video-popup-close=""></div>
  <div class="video-popup_dialog" role="dialog" aria-modal="true" aria-label="Video">
    <button class="video-popup_close" type="button" aria-label="Close video" data-video-popup-close="">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="4" x2="20" y2="20"></line>
        <line x1="20" y1="4" x2="4" y2="20"></line>
      </svg>
    </button>
    <div class="video-popup_video-wrap"></div>
    <div class="video-popup_controls">
      <button class="video-popup_play-btn" type="button" aria-label="Play">
        <svg class="video-popup_icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="video-popup_icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14"></rect>
          <rect x="14" y="5" width="4" height="14"></rect>
        </svg>
      </button>
      <div class="video-popup_progress" tabindex="0" role="slider" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="video-popup_progress-track">
          <div class="video-popup_progress-fill"></div>
          <div class="video-popup_progress-handle"></div>
        </div>
      </div>
      <div class="video-popup_time">
        <span class="video-popup_time-current">0:00</span>
        <span class="video-popup_time-sep">/</span>
        <span class="video-popup_time-duration">0:00</span>
      </div>
      <div class="video-popup_volume">
        <button class="video-popup_volume-btn" type="button" aria-label="Mute">
          <svg class="video-popup_icon-vol-on" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M4 9v6h4l5 5V4L8 9H4z"></path>
            <path d="M16.5 12c0-1.5-.8-2.8-2-3.4v6.8c1.2-.6 2-1.9 2-3.4z"></path>
          </svg>
          <svg class="video-popup_icon-vol-off" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none" aria-hidden="true">
            <path d="M4 9v6h4l5 5V4L8 9H4z"></path>
            <line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2"></line>
            <line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2"></line>
          </svg>
        </button>
        <input class="video-popup_volume-slider" type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
      </div>
      <button class="video-popup_fullscreen-btn" type="button" aria-label="Full screen">
        <svg class="video-popup_icon-fullscreen-enter" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
          <path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
          <path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
          <path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
        </svg>
        <svg class="video-popup_icon-fullscreen-exit" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none" aria-hidden="true">
          <path d="M9 3v3a2 2 0 0 1-2 2H4"></path>
          <path d="M15 3v3a2 2 0 0 0 2 2h3"></path>
          <path d="M9 21v-3a2 2 0 0 0-2-2H4"></path>
          <path d="M15 21v-3a2 2 0 0 1 2-2h3"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
