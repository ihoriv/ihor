---
import '../../styles/sections/marquee.css';
import { marquee } from '../../data/site';
const groups = [0, 1, 2, 3];
---
<section class="mq-wrap" aria-label="At a glance" style="position:relative;overflow:hidden;background:var(--white);padding:calc(80 * var(--p)) 0 calc(32 * var(--p))">
  <div class="mq" style="position:relative;z-index:1">
    {groups.map((g) => (
      <div class="mq-g" aria-hidden={g > 0 ? 'true' : undefined}>
        {marquee.map((item) => (<><span>{item}</span><i>✱</i></>))}
      </div>
    ))}
  </div>
</section>
