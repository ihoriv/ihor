---
import '../../styles/sections/work.css';
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';

/* Slots on the 12-column grid, two works per row, in reading order: [first column, column span, top offset, drift, sway, turn].
   The offset staggers each pair; drift is how far a tile travels up while it crosses the screen, sway how far it slides
   sideways and turn how many degrees it rotates on the way, so neighbours move at different speeds and in different directions. */
const slots: [number, number, number, number, number, number][] = [
  [1, 7, 0, 50, 16, -1.5], [9, 4, 200, 170, -28, 3],
  [1, 5, 120, 140, 24, 2.5], [7, 6, 0, 60, -14, -1.5],
  [2, 5, 0, 170, -22, -3], [8, 5, 160, 70, 18, 2],
  [1, 7, 0, 60, -16, 1.5], [9, 4, 240, 160, 26, -3],
];
---
<section id="cases" class="wk2">
  <div class="in">
    <div class="wk2-hd g12">
      <p class="wk2-lead">I build websites for companies whose work is better than their site. Your buyers understand what you do in the first five seconds, and your sales team gets better leads.</p>
    </div>
    <div class="wk2-g">
      {projects.map((p, i) => {
        const [c, span, top, d, x, r] = slots[i] ?? [i % 2 ? 7 : 1, 6, 0, 80, 0, 0];
        return (
          <a class="case wk2-t" href={p.url} target="_blank" rel="noopener" style={`grid-column:${c} / span ${span};grid-row:${Math.floor(i / 2) + 1};--top:${top};--d:${d};--x:${x};--r:${r}`}>
            <div class="wk2-tl"><div class="case-m"><span class="wk2-gl" aria-hidden="true"></span><Image src={p.image} alt={p.alt} widths={[640, 960, 1400]} sizes={`(max-width: 767px) 100vw, (max-width: 1023px) 50vw, ${Math.round((span / 12) * 100)}vw`} loading={i < 2 ? 'eager' : 'lazy'} /></div><span class="wk2-k">{p.industry}</span><span class="wk2-c">{p.name}</span></div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { initCaseHover } from '../../scripts/case-hover';
  import { initWorkTilt } from '../../scripts/work-tilt';
  initCaseHover();
  initWorkTilt();
</script>
