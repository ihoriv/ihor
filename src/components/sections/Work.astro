---
import '../../styles/sections/work.css';
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';

const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
const facts = [
  { text: ['Websites built', 'from scratch'], col: '1/span 3' },
  { text: ['Design · strategy', 'engineering'], col: '4/span 3' },
  { text: ['Clients from Europe, USA,', 'Asia, Australia, Canada'], col: '7/span 3' },
  { text: ['Premium Webflow', 'partner'], col: '10/span 3', right: true },
];
---
<section id="cases" style="position:relative;overflow:clip;background:var(--black);color:var(--white);padding:calc(96 * var(--p)) calc(40 * var(--p)) calc(120 * var(--p))">
  <div class="in">
    <div class="meta cs-meta" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:calc(24 * var(--p));padding-top:calc(40 * var(--p));border-top:1px solid rgba(255,255,255,.3);color:rgba(255,255,255,.72)">
      {facts.map((f) => <span style={`grid-column:${f.col}${f.right ? ';text-align:right' : ''}`}>{f.text[0]}<br />{f.text[1]}</span>)}
    </div>
    <p class="cs-lead" style="margin:calc(96 * var(--p)) 0 0;font-size:calc(40 * var(--p));line-height:calc(44 * var(--p));font-weight:400;letter-spacing:-0.025em;width:calc(1017 * var(--p));max-width:none">I build websites for companies whose work is better than their site. Strategy, design and code come <span class="ser" style="font-size:1.06em">from one person,</span> so nothing gets lost on the way to launch.</p>

    <div class="meta cs-sel" style="display:flex;justify-content:space-between;margin-top:calc(160 * var(--p));color:rgba(255,255,255,.72)"><h2 style="margin:0;font:inherit">(Selected work)</h2><span>01 — {total}</span></div>
    <div class="stack" style={`margin-top:calc(40 * var(--p));timeline-scope:${featured.slice(1).map((_, i) => `--c${i + 2}`).join(',')}`}>
      {featured.map((p, i) => {
        const last = i === featured.length - 1;
        const scStyle = `top:calc(${40 + i * 24} * var(--p));${i > 0 ? `view-timeline-name:--c${i + 1};` : ''}`;
        return (
          <div class="sc" style={scStyle}>
            <a class="case sc-in" href={p.url} target="_blank" rel="noopener" style={last ? 'animation:none' : `animation-timeline:--c${i + 2}`}>
              <div class="case-m"><Image src={p.image} alt={p.alt} widths={[800, 1200, 1800]} sizes="(max-width: 1023px) 100vw, 66vw" loading={i === 0 ? 'eager' : 'lazy'} /></div>
              <div class="case-i">
                <div style="display:flex;flex-direction:column;gap:calc(24 * var(--p))">
                  <span class="ser mute" style="font-size:calc(24 * var(--p));line-height:calc(30 * var(--p))">{pad(i + 1)}</span>
                  <h3 style="margin:0;font-size:calc(48 * var(--p));line-height:calc(46 * var(--p));font-weight:400;letter-spacing:-0.03em">{p.name}</h3>
                  <span class="meta mute">{p.industry}<br />{p.services}</span>
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <div class="meta mute" style="display:flex;justify-content:space-between;margin-top:calc(64 * var(--p))"><span>(More work)</span><span>{pad(featured.length + 1)} — {total}</span></div>
    <div class="grid2" style="margin-top:calc(40 * var(--p))">
      {more.map((p, i) => (
        <a class="case" href={p.url} target="_blank" rel="noopener">
          <div class="case-m"><Image src={p.image} alt={p.alt} widths={[700, 1100]} sizes="(max-width: 767px) 100vw, 50vw" /></div>
          <div class="case-i">
            <span class="ser mute" style="grid-column:1/span 1;font-size:calc(20 * var(--p));line-height:calc(28 * var(--p))">{pad(featured.length + i + 1)}</span>
            <h3 style="grid-column:2/span 3;margin:0;font-size:calc(32 * var(--p));line-height:calc(36 * var(--p));font-weight:400;letter-spacing:-0.02em">{p.name}</h3>
            <span class="meta" style="grid-column:5/span 2;text-align:right;padding-top:calc(8 * var(--p))"><span class="go">view website <span aria-hidden="true">↗</span></span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { initCaseHover } from '../../scripts/case-hover';
  initCaseHover();
</script>
