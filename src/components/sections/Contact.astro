---
import '../../styles/sections/contact.css';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Footer from './Footer.astro';
import avatar from '../../assets/people/ihor-avatar.jpg';
import desk from '../../assets/about/desk.jpg';
import { site } from '../../data/site';
---
<!-- About and the call to action in one: Ihor's desk photo behind the closing line, a short bio and the booking card.
     The black footer sits under it and is revealed as this section scrolls away. -->
<div class="ft-zone">
<section id="about" class="ct fit" aria-label="About Ihor and starting a project">
  <Image class="ct-bg" src={desk} alt="Ihor at his desk, working on a website" widths={[800, 1400, 2200]} sizes="100vw" />
  <div class="ct-in">
    <div class="ct-bot">
      <div class="ct-c">
        <h2 class="ct-h"><span class="ct-l"><span>Let’s make your<br class="ct-br" /> website</span></span>{' '}<span class="ct-l"><span>as strong<br class="ct-br" /> as your company.</span></span></h2>
        <p class="ct-p">I’m Ihor, a senior designer and design engineer. For over ten years I’ve watched strong companies lose deals to weaker ones with better websites, so I treat yours as a sales tool first and a design project second.</p>
      </div>
      <div class="ct-bk" id="contact">
        <div class="ct-who">
          <Image src={avatar} alt="" width={160} height={160} />
          <span><span class="ct-k">Intro call with</span><b>{site.name}</b></span>
        </div>
        <ul class="ct-pts">
          <li>A fixed quote after the call</li>
          <li>Launch in 3 to 8 weeks</li>
        </ul>
        <Button href={site.booking} external label="book an intro call" class="ct-go" />
        <p class="ct-m"><span>Prefer email?</span><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>
  </div>
</section>
<Footer />
</div>
