---
import '../../styles/sections/stories.css';
import { Image, getImage } from 'astro:assets';
import { stories } from '../../data/stories';
const posters = await Promise.all(stories.map(async (s) => (await getImage({ src: s.poster, width: 900, format: 'webp' })).src));
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="cs fit" aria-label="Client stories" aria-roledescription="carousel">
  <div class="in">
    <div class="cs-top g12">
      <h2 class="cs-h">The clients say it better than I can.</h2>
      <div class="cs-nav">
        <span class="cs-ct" aria-hidden="true"><b class="cs-i">01</b> / {pad(stories.length)}</span>
        <button class="cs-a" type="button" data-go="-1" aria-label="Previous review"><span aria-hidden="true">←</span></button>
        <button class="cs-a" type="button" data-go="1" aria-label="Next review"><span aria-hidden="true">→</span></button>
      </div>
    </div>
    <div class="cs-sl" aria-live="polite">
      {stories.map((s, i) => (
        <article class={`cv g12${i === 0 ? ' on' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${stories.length}: ${s.client}`} inert={i !== 0}>
          <div class="cv-v">
            <video muted loop playsinline preload={i === 0 ? 'metadata' : 'none'} poster={posters[i]} src={s.video}></video>
            <button class="cv-o" type="button" aria-label={`Play video review from ${s.author} with sound`}>
              <span class="cv-pb" aria-hidden="true"><span class="cv-pi"><svg width="10" height="12" viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg></span>watch with sound</span>
            </button>
            <span class="cv-k">{s.industry}</span>
          </div>
          <div class="cv-b">
            <div class="cv-hd"><Image class="cv-lg" src={s.logo} alt={s.logoAlt} height={48} /></div>
            <blockquote class="cv-q"><p>{s.quote}</p></blockquote>
            <div class="cv-au"><b>{s.author}</b><span>{s.role}</span></div>
            <dl class="cv-st">
              {s.stats.map((st) => <div><dd>{st.value}<i>{st.unit}</i></dd><dt>{st.label}</dt></div>)}
            </dl>
            <a class="cv-go" href={s.url} target="_blank" rel="noopener">Visit {s.client} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
    <div class="cs-tabs" role="tablist" aria-label="Choose a review">
      {stories.map((s, i) => (
        <button class="cs-tb" type="button" role="tab" data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>
          <span class="cs-tn">{pad(i + 1)}</span>{s.client}
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { initStories } from '../../scripts/stories';
  initStories();
</script>
