---
/** A legal document page (privacy policy, terms): title, sticky contents, numbered sections. */
import '../../styles/sections/legal.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from '../ui/Button.astro';
import Label from '../ui/Label.astro';
import { legalDocs, type LegalDoc } from '../../data/legal';
import { site } from '../../data/site';

interface Props { doc: LegalDoc }
const { doc } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const host = new URL(site.url).host;
---
<div class="lg-top"><Header /></div>

<main class="lg">
  <header class="lg-hd" id="content" tabindex="-1">
    <Label text="Legal" class="fade" />
    <h1 class="lg-t">
      <span class="lg-l"><span class="rise" style="animation-delay:.1s">{doc.heading[0]}</span></span>
      <span class="lg-l lg-l2"><span class="rise ser" style="animation-delay:.22s">{doc.heading[1]}</span></span>
    </h1>
    <div class="lg-meta fade" style="animation-delay:.4s">
      <p><span class="ov">Last updated</span><time datetime={doc.updatedIso}>{doc.updated}</time></p>
      <p><span class="ov">Operated by</span><span>PE {site.name}</span></p>
      <nav class="lg-sw" aria-label="Legal documents">
        {legalDocs.map((d) => <a href={`/${d.slug}/`} aria-current={d.slug === doc.slug ? 'page' : undefined}>{d.name}</a>)}
      </nav>
    </div>
  </header>

  <div class="lg-body">
    <nav class="lg-toc" aria-label="Contents">
      <span class="ov">(Contents)</span>
      <ol>
        {doc.sections.map((s, i) => <li><a href={`#${s.id}`}><span class="ser">{pad(i + 1)}</span>{s.title}</a></li>)}
      </ol>
    </nav>

    <article class="lg-doc">
      {doc.sections.map((s, i) => (
        <section class="lg-s" id={s.id} aria-labelledby={`${s.id}-h`}>
          <div class="lg-sh">
            <span class="ser lg-n" aria-hidden="true">{pad(i + 1)}</span>
            <h2 id={`${s.id}-h`}>{s.title}</h2>
          </div>
          <div class="lg-sb">
            {s.blocks.map((b) => {
              if ('p' in b) return <p set:html={b.p} />;
              if ('h3' in b) return <h3>{b.h3}</h3>;
              if ('note' in b) return <div class="lg-note" role="note"><span class="ov">{b.note.term}</span><p set:html={b.note.text} /></div>;
              if ('list' in b)
                return (
                  <ul class:list={['lg-ls', b.list.some((it) => it.term) && 'lg-ls-t']}>
                    {b.list.map((it) => <li>{it.term && <b>{it.term}</b>}<span set:html={it.text} /></li>)}
                  </ul>
                );
              return (
                <dl class="lg-ct">
                  <div><dt class="ov">Operator</dt><dd>PE {site.name}</dd></div>
                  <div><dt class="ov">Email</dt><dd><a class="go" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
                  <div><dt class="ov">Website</dt><dd><a class="go" href={site.url}>{host}</a></dd></div>
                </dl>
              );
            })}
          </div>
        </section>
      ))}
    </article>
  </div>
</main>

<section class="lg-end" aria-label="Questions">
  <div class="in">
    <div class="lg-q">
      <p class="lg-qh">Questions about this page? <span class="ser">Just ask.</span></p>
      <div class="lg-qa">
        <a class="lg-qm" href={`mailto:${site.email}`}>{site.email}</a>
        <Button href={site.booking} label="book an intro call" variant="l" size="sm" />
      </div>
    </div>
    <Footer />
  </div>
</section>

<script>
  import { initLegalToc } from '../../scripts/legal-toc';
  initLegalToc();
</script>
