---
import '../../styles/sections/process.css';
import { steps, weeks } from '../../data/process';
const pad = (n: number) => String(n).padStart(2, '0');
const pct = (w: number) => `${((w / weeks) * 100).toFixed(3)}%`;
---
<section id="process" class="pr fit" aria-label="Process">
  <div class="in">
    <div class="pr-hd g12">
      <h2 class="pr-h">Three steps.<br />No surprises.</h2>
      <p class="pr-sub">Fixed price, agreed after week one. Most projects launch in 3 to 8 weeks.</p>
    </div>

    <!-- The 8 weeks at a glance: each step is a bar as long as it takes. -->
    <div class="pr-tl" aria-hidden="true">
      <div class="pr-wk">{Array.from({ length: weeks }, (_, i) => <span>W{i + 1}</span>)}</div>
      <div class="pr-tr">
        {steps.map((s, i) => (
          <span class="pr-sg" style={`left:${pct(s.from - 1)};width:${pct(s.to - s.from + 1)};animation-name:prb${i}`}>
            <span class="pr-sl"><b>{pad(i + 1)}</b>{s.label}</span>
          </span>
        ))}
        <span class="pr-mk" style={`left:${pct(steps[0].to)};animation-name:prm0`}><i></i>Fixed quote</span>
        <span class="pr-mk pr-mk-e" style="left:100%;animation-name:prm1"><i></i>Launch ✦</span>
      </div>
    </div>

    <ol class="pr-list">
      {steps.map((s, i) => (
        <li class="pr-c" style={`animation-name:prc${i}`}>
          <div class="pr-top"><span class="pr-n">{pad(i + 1)}</span><span class="pr-w meta">{s.when}</span></div>
          <h3 class="pr-t">{s.title}</h3>
          <p class="pr-x">{s.text}</p>
          <ul class="pr-in" aria-label="Included">{s.items.map((it) => <li>{it}</li>)}</ul>
          <p class="pr-g"><span class="meta">You get</span><span class="pr-r2">{s.result}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>
