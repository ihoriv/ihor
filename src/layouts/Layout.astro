---
import '../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'ihor.me — Enterprise level websites built to convert visitors into clients',
  description = 'From positioning and structure to visual design and Webflow development — one specialist handles the full project, start to finish.',
  image = '/images/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#e8e8e3" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ihor.me" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body>
    <div class="progressive-blur_wrap" aria-hidden="true">
      <div class="progressive-blur_panel is-1"></div>
      <div class="progressive-blur_panel is-2"></div>
      <div class="progressive-blur_panel is-3"></div>
      <div class="progressive-blur_panel is-4"></div>
      <div class="progressive-blur_panel is-5"></div>
      <div class="progressive-blur_panel is-6"></div>
      <div class="progressive-blur_panel is-7"></div>
      <div class="progressive-blur_panel is-8"></div>
      <div class="progressive-blur_panel is-9"></div>
      <div class="progressive-blur_panel is-10"></div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
