---
import '../styles/tokens.css';
import '../styles/base.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { buildSchema } from '../data/schema';
import avatarSrc from '../assets/people/ihor-avatar.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Hold the hero copy until the project band has fanned out (homepage only). */
  intro?: boolean;
  /** Name of this page in the breadcrumb trail (pages below the homepage). */
  breadcrumb?: string;
  /** ISO date the page content last changed. */
  modified?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}
const { title = site.title, description = site.description, intro = false, breadcrumb, modified, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isHome = Astro.url.pathname === '/';
/** Social preview image, shared by every page (2400×1260, i.e. 1200×630 at 2x). */
const ogImage = new URL('/og.webp', site.url).href;
const ogAlt = 'Ihor Ivanchenko: websites for companies that outgrew theirs. Strategy, design and engineering from one senior specialist.';
const avatar = new URL((await getImage({ src: avatarSrc, width: 400, format: 'jpg' })).src, site.url).href;
const schema = noindex ? null : buildSchema({ url: canonical, title, description, ogImage, avatar, breadcrumb, modified, isHome });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="ihor.me" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preload" href="/fonts/mariupol-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nyght-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    {intro && <script is:inline>
      // Hold the hero copy until the project band has fanned out (released by hero-band.ts).
      // The timeout is a backstop in case that script never runs.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        setTimeout(function () { document.documentElement.classList.remove('intro'); }, 4000);
      }
    </script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary of this site" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
