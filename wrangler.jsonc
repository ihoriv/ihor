// Cloudflare Worker that serves ihor.me as static assets.
// Deploy: npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihor",
  "compatibility_date": "2025-09-01",
  // Serve only on ihor.me: no duplicate copy on *.workers.dev, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /privacy and /privacy/ both work; the trailing-slash version is canonical.
    "html_handling": "auto-trailing-slash"
  }
}
